# Normalize text files to LF in the repository and in the working tree.
# This keeps diffs stable across Linux, macOS and Windows. Git converts the
# working tree back to CRLF only for the Windows-native formats listed below.
* text=auto eol=lf

# Windows-native scripts and project files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Binary assets are never normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary
*.msi binary
*.zip binary
*.apk binary
